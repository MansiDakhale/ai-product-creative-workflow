# ─── Docker Compose reads THIS file (project root .env) ───
# Copy to .env and fill in, OR keep keys only in backend/.env for local dev.

GROQ_API_KEY=
TOGETHER_API_KEY=
REPLICATE_API_KEY=
HF_TOKEN=

# Stability AI (optional) — set if using Stability endpoints
STABILITY_API_KEY=
# If you want to override the default Stability endpoint (model-specific path)
# e.g. https://api.stability.ai/v1/generation/stable-diffusion-xl/text-to-image
STABILITY_API_URL=

# For local (uvicorn + local Redis): redis://localhost:6379/0
# For Docker Compose services: redis://redis:6379/0 (Compose service name 'redis')
REDIS_URL=redis://localhost:6379/0
OUTPUT_DIR=./outputs

# Optional: only needed if you run `npm run dev` from frontend/ with direct API URL
# VITE_API_URL=http://localhost:8000

# SSL verification: set to "false" for local debugging on Windows where CA
# verification may fail; not recommended for production.
SSL_VERIFY=true

# Preferred Groq model names (optional)
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
