# Local backend keys (copy to backend/.env)
# Loaded automatically when running uvicorn / celery from backend/

GROQ_API_KEY=
TOGETHER_API_KEY=
REPLICATE_API_KEY=
HF_TOKEN=
FAL_KEY=

REDIS_URL=redis://localhost:6379/0
OUTPUT_DIR=./outputs

# TLS on Windows: if Groq fails with CERTIFICATE_VERIFY_FAILED, add this line:
SSL_VERIFY=false
