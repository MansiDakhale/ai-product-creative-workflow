# Local backend keys (copy to backend/.env)
# Loaded automatically when running uvicorn / celery from backend/

GROQ_API_KEY=
TOGETHER_API_KEY=
REPLICATE_API_KEY=
HF_TOKEN=

REDIS_URL=redis://localhost:6379/0
OUTPUT_DIR=./outputs

# Vercel Blob (media storage)
BLOB_READ_WRITE_TOKEN=
BLOB_BASE_URL=

# Supabase Postgres (metadata storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE=campaign_workflows

# TLS on Windows: if Groq fails with CERTIFICATE_VERIFY_FAILED, add this line:
SSL_VERIFY=false
